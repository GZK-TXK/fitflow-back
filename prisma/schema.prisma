generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  phone            String?
  avatarUrl        String?
  password         String?
  firebaseUid      String?   @unique
  role             String    @default("TRAINER")
  status           String    @default("ACTIVE")
  lastSeenAt       DateTime?
  stripeCustomerId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  clients            Client[]     @relation("TrainerClients")
  clientAccount      Client?      @relation("ClientAccount")
  exercises          Exercise[]
  invitationsCreated Invitation[] @relation("InvitationCreator")
}

model Client {
  id                String             @id @default(cuid())
  name              String
  email             String?
  phone             String?
  notes             String?
  userId            String
  user              User               @relation("TrainerClients", fields: [userId], references: [id], onDelete: Cascade)
  accountUserId     String?            @unique
  account           User?              @relation("ClientAccount", fields: [accountUserId], references: [id], onDelete: SetNull)
  workouts          Workout[]
  scheduledWorkouts ScheduledWorkout[]
  invitations       Invitation[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model Exercise {
  id           String          @id @default(cuid())
  name         String
  description  String?
  category     String?
  videoUrl     String?
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutItems WorkoutItem[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Workout {
  id                String             @id @default(cuid())
  title             String
  description       String?
  clientId          String
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items             WorkoutItem[]
  scheduledWorkouts ScheduledWorkout[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model WorkoutItem {
  id         String   @id @default(cuid())
  workoutId  String
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets       Int?
  reps       Int?
  weight     Float?
  restTime   Int?
  order      Int      @default(0)
}

model ScheduledWorkout {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invitation {
  id          String    @id @default(cuid())
  token       String    @unique
  type        String    // 'TRAINER' | 'CLIENT'
  email       String
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}