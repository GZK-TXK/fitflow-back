# Puerto del servidor
PORT=4000

# Cadena de conexión a PostgreSQL (Neon). Reemplaza con tus credenciales.
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST/neondb?sslmode=require"

# Clave secreta para firmar los JWT. Genera una aleatoria y larga:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="cambia_esto_por_una_clave_larga_y_aleatoria"

# Origen(es) permitidos para CORS, separados por coma.
FRONTEND_URL="http://localhost:5173"

# Firebase Admin (login con Google)
FIREBASE_PROJECT_ID="tu-proyecto"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@tu-proyecto.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudinary (fotos de perfil)
CLOUDINARY_CLOUD_NAME="tu-cloud-name"
CLOUDINARY_API_KEY="tu-api-key"
CLOUDINARY_API_SECRET="tu-api-secret"